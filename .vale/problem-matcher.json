{
  "problemMatcher": [
    {
      "owner": "inkless-vale",
      "pattern": [
        {
          "regexp": "^(.+?):(\\d+):(\\d+) (error|warning|suggestion) \\[([^\\]]+)\\] (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      ]
    }
  ]
}
