{
  "apiKey": 503,
  "type": "request",
  "listeners": ["controller"],
  "name": "SetClassicPrefixInRemoteStorageRequest",
  "validVersions": "0",
  "flexibleVersions": "0+",
  "fields": [
    { "name": "BrokerId", "type": "int32", "versions": "0+", "entityType": "brokerId",
      "about": "The broker ID of the requesting leader." },
    { "name": "BrokerEpoch", "type": "int64", "versions": "0+", "default": "-1",
      "about": "The epoch of the requesting broker." },
    { "name": "Topics", "type": "[]TopicData", "versions": "0+",
      "about": "The topics whose classic prefix is in remote storage.", "fields": [
      { "name": "TopicId", "type": "uuid", "versions": "0+",
        "about": "The topic ID." },
      { "name": "Partitions", "type": "[]PartitionData", "versions": "0+",
        "about": "The partitions whose classic prefix is in remote storage.", "fields": [
        { "name": "PartitionId", "type": "int32", "versions": "0+",
          "about": "The partition ID." },
        { "name": "ClassicToDisklessStartOffset", "type": "int64", "versions": "0+",
          "about": "The committed seal: the first offset in diskless format." },
        { "name": "LeaderEpoch", "type": "int32", "versions": "0+",
          "about": "The leader epoch seen by the broker." }
      ]}
    ]}
  ]
